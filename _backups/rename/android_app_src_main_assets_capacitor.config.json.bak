{
	"appId": "msidcom.prof.app",
	"appName": "msidcom-prof.app",
	"webDir": "dist",
	"backgroundColor": "#b2e9f6",
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"SafeArea": {
			"statusBarStyle": "LIGHT",
			"navigationBarStyle": "LIGHT"
		},
		"Keyboard": {
			"resize": "none",
			"resizeOnFullScreen": true
		}
	}
}
